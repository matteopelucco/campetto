generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Categoria {
  PICCOLI_AMICI
  PULCINI
  ESORDIENTI
  GIOVANISSIMI
  ALLIEVI
}

enum Ruolo {
  PORTIERE
  DIFENSORE
  CENTROCAMPISTA
  ATTACCANTE
}

enum TipoVisita {
  AGONISTICA
  NON_AGONISTICA
}

enum EsitoVisita {
  IDONEO
  NON_IDONEO
  DA_RIPETERE
}

enum StatoPagamento {
  IN_ATTESA
  PAGATO
  SCADUTO
  ANNULLATO
}

enum MetodoPagamento {
  CONTANTI
  BONIFICO
  POS
  ALTRO
}

model Squadra {
  id         Int        @id @default(autoincrement())
  nome       String
  categoria  Categoria
  stagione   String
  allenatore String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  giocatori  Giocatore[]
}

model Giocatore {
  id             Int            @id @default(autoincrement())
  nome           String
  cognome        String
  dataNascita    DateTime
  codiceFiscale  String?
  indirizzo      String?
  numeroMaglia   Int?
  ruolo          Ruolo?
  note           String?
  attivo         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  squadraId      Int?
  squadra        Squadra?       @relation(fields: [squadraId], references: [id])
  genitori       Genitore[]
  visiteMediche  VisitaMedica[]
  pagamenti      Pagamento[]
}

model Genitore {
  id          Int       @id @default(autoincrement())
  nome        String
  cognome     String
  telefono    String?
  email       String?
  relazione   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  giocatoreId Int
  giocatore   Giocatore @relation(fields: [giocatoreId], references: [id])
}

model VisitaMedica {
  id           Int         @id @default(autoincrement())
  tipo         TipoVisita
  dataVisita   DateTime
  dataScadenza DateTime
  medico       String?
  struttura    String?
  esito        EsitoVisita
  note         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  giocatoreId  Int
  giocatore    Giocatore   @relation(fields: [giocatoreId], references: [id])
}

model Pagamento {
  id            Int              @id @default(autoincrement())
  descrizione   String
  importo       Decimal
  dataScadenza  DateTime
  dataPagamento DateTime?
  stato         StatoPagamento
  metodo        MetodoPagamento?
  note          String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  giocatoreId   Int
  giocatore     Giocatore        @relation(fields: [giocatoreId], references: [id])
}
